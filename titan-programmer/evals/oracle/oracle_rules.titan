local rules = import "rules"
local strings = import "string"

function main(_args: {string}): integer
  -- 1. Module-init const initialized via root do ... end
  local thr? = rules.default_threshold
  if thr == nil or thr ~= 10 then return 1 end

  -- 2. boolean? explicit nil vs false distinction
  if rules.is_explicitly_disabled(nil) then return 2 end
  if rules.is_explicitly_disabled(true) then return 3 end
  if not rules.is_explicitly_disabled(false) then return 4 end

  -- 3. Named declaration call + Record(...) generic construction
  local r_allow = rules.make_rule {
    weight = 15,
    id = "auth",
    payload = "jwt",
    enabled = true,
  }
  local r_num = rules.Rule<|integer|>("num", 42, nil, 7)
  if r_allow.id ~= "auth" or r_allow.payload ~= "jwt" or r_allow:score() ~= 15 then return 5 end
  if r_num.id ~= "num" or r_num.payload ~= 42 or r_num:score() ~= 7 then return 6 end

  -- 4. Constrained generic dispatch over Interface
  if rules.describe_matchable(r_allow) ~= "auth:15" then return 7 end
  if rules.describe_matchable(r_num) ~= "num:7" then return 8 end

  -- 5. Interface field snapshot + dynamic method dispatch + downcast
  local snap_id, updated_score = rules.snapshot_and_eval(r_allow, 5)
  if snap_id ~= "auth" or updated_score ~= 20 or r_allow:score() ~= 20 then return 9 end
  local view: rules.Matchable = r_allow
  if not (view is rules.Rule<|string|>) then return 10 end
  local back = view as rules.Rule<|string|>
  if back.payload ~= "jwt" then return 11 end

  -- 6. Union evaluation + case formatting (including keyword part `end`)
  if rules.format_decision(nil) ~= "none" then return 12 end
  local d_allow = rules.evaluate(r_allow, thr)
  if rules.format_decision(d_allow) ~= "allow:auth=jwt" then return 13 end

  local r_skip = rules.make_rule { id = "s1", payload = "p", weight = 25, enabled = nil }
  if rules.format_decision(rules.evaluate(r_skip, thr)) ~= "skip" then return 14 end

  local r_off = rules.make_rule { id = "s2", payload = "p", weight = 25, enabled = false }
  if rules.format_decision(rules.evaluate(r_off, thr)) ~= "deny:403:disabled" then return 15 end

  local r_low = rules.make_rule { id = "s3", payload = "p", weight = 4, enabled = true }
  if rules.format_decision(rules.evaluate(r_low, thr)) ~= "deny:400:below_threshold" then return 16 end

  -- 7. Error handling with catch + bare raise preserving traceback from rules module
  local r_neg = rules.make_rule { id = "bad", payload = "x", weight = -2, enabled = true }
  local caught_msg = ""
  local caught_tb = ""
  do
    rules.evaluate(r_neg, thr)
    return 17
  catch
    if error is string then
      caught_msg = error as string
    end
    caught_tb = traceback
  end
  if caught_msg ~= "negative score" then return 18 end
  local s? = strings.find(caught_tb, "rules")
  if s == nil then return 19 end

  return 0
end
