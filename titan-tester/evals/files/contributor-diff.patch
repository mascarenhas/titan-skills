diff --git a/titan-compiler/checker.lua b/titan-compiler/checker.lua
index 1a2b3c4..5d6e7f8 100644
--- a/titan-compiler/checker.lua
+++ b/titan-compiler/checker.lua
@@ -412,7 +412,7 @@ function checker:check_method_call(node)
   if not method then
-    self:type_error(node, "unknown method '%s'", node.method)
+    self:type_error(node, "type '%s' has no method '%s'", receiver_name, node.method)
