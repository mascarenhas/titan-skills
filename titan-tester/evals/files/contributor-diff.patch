diff --git a/spec/checker/method_call_spec.lua b/spec/checker/method_call_spec.lua
new file mode 100644
--- /dev/null
+++ b/spec/checker/method_call_spec.lua
@@ -0,0 +1,14 @@
+local helpers = require "spec.support.helpers"
+describe("method call diagnostics", function()
+  it("includes receiver type name in unknown method error", function()
+    local _, errs = helpers.run_checker("record R end\nfunction f(r: R) r:missing() end")
+    assert.truthy(errs:match("type 'R' has no method 'missing'"))
+  end)
+end)
diff --git a/titan/url.titan b/titan/url.titan
