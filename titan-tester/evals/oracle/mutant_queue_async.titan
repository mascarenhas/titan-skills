local async = import "async"
local timer = import "timer"

local function normalize_capacity(cap: integer): integer
  if cap < 1 then
    return 1
  end
  if cap > 64 then
    return 64
  end
  return cap
end

record JobQueue
  local const max_size: integer
  local const items: {string}
  local head: integer
  local tail: integer
  local closed: boolean
end

function open(capacity: integer): JobQueue
  return JobQueue(normalize_capacity(capacity), {}, 1, 0, false)
end

function JobQueue:capacity(): integer
  return self.max_size
end

function JobQueue:len(): integer
  return self.tail - self.head + 1
end

function JobQueue:is_closed(): boolean
  return self.closed
end

function JobQueue:enqueue(item: string): boolean
  if item == "" then
    raise "empty item"
  end
  if self.closed or self:len() >= self.max_size then
    return false
  end
  self.tail = self.tail + 1
  self.items[self.tail] = item
  return true
end

function JobQueue:dequeue(): string?
  if self:len() <= 0 then
    return nil
  end
  local value? = self.items[self.head]
  self.items[self.head] = nil
  self.head = self.head + 1
  return value
end

function JobQueue:close()
  self.closed = true
end

-- Mutant 2: accepts negative delay and drops last item.
function drain_async(items: {string}, delay_ms: integer): {string}
  if delay_ms > 0 then
    timer.sleep(delay_ms)
  end
  local out: {string} = {}
  for i = 1, #items - 1 do
    local item? = items[i]
    if item ~= nil then
      out[#out + 1] = item
    end
  end
  return out
end
